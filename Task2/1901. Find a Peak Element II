class Solution {
    public int[] findPeakGrid(int[][] mat) {
        int n = mat.length;
        if(n == 1){
            int max = findMax(mat[0]);
            return new int[]{0, max};
        }
        int start = 0;
        int end = n - 1;
        while(start <= end){
            int mid = start + (end - start) / 2;
            int max = findMax(mat[mid]);
            if(mid == 0){
                if(mat[mid][max] > mat[mid + 1][max]){
                    return new int[]{mid, max};
                }
            }
            if(mid == n - 1){
                if(mat[mid][max] > mat[mid - 1][max]){
                    return new int[]{mid, max};
                }
            }
            else if(mid > 0 && mid < n){
                if(mat[mid][max] > mat[mid + 1][max] && mat[mid][max] > mat[mid - 1][max]){
                    return new int[]{mid, max};
                }
            }
            if(mat[mid][max] < mat[mid + 1][max]){
                start =  mid + 1;
            }
            else{
                end = mid - 1;
            }
        }
        return new int[]{-1, -1};
    }
    private int findMax(int []arr){
        int max = Integer.MIN_VALUE;
        int idx = 0;
        for(int i = 0; i < arr.length; i++){
            if(arr[i] > max){
                max = arr[i];
                idx = i;
            }
        }
        return idx;
    }
}
